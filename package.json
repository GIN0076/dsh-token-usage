{
  "name": "@local/token-usage",
  "version": "1.3.0",
  "type": "module",
  "description": "Token usage dashboard for the DeepSeek Harness settings panel: per-day/week/month tokens by model, pure-SVG charts, zero host changes.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "token-usage",
    "usage-stats",
    "token-counter"
  ],
  "homepage": "https://github.com/GIN0076/dsh-token-usage#readme",
  "bugs": {
    "url": "https://github.com/GIN0076/dsh-token-usage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIN0076/dsh-token-usage.git"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./stats.js": "./stats.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "host.js",
    "client.js",
    "stats.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
